{
  "expo": {
    "name": "WordQuest",
    "slug": "wordquest",
    "version": "0.1.0",
    "scheme": "wordquest",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#12102A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "WordQuest uses your photo library so you can submit evidence of a word used in the real world.",
          "cameraPermission": "WordQuest uses your camera so you can photograph a word used in the real world."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#12102A"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "./plugins/withPodDeploymentTarget",
      "./plugins/withSceneDelegateWindow",
      "./plugins/withSceneURLHandling"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wordquest.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "AppDelegate"
              }
            ]
          }
        },
        "NSLocalNetworkUsageDescription": "WordQuest uses your local network to connect to the Metro development server while testing a development build."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#12102A"
      },
      "package": "com.wordquest.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "http://localhost:3002/api/v1",
      "eas": {
        "projectId": "0ef38d51-a343-43ae-83ef-fe83e173374d"
      }
    },
    "owner": "barthiwus-team"
  }
}
