# ── App ──────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# "*" is fine for local dev only — in production this MUST be set to
# the real app origin(s); the server refuses to boot with NODE_ENV=production
# and a wildcard CORS_ORIGIN (see AppConfigService.corsOrigin).
CORS_ORIGIN=*

# ── Database ─────────────────────────
# Without a `connection_limit`, Prisma sizes its pool from the
# container's CPU count (num_cpus * 2 + 1) — on a small/low-CPU
# production instance this can be too small for a burst of concurrent
# Boss Battle answer submissions (each opens its own interactive
# transaction), producing "transaction already closed" errors under
# real concurrent load rather than the fast, correct rejection a losing
# racer should get (see BossBattleService.submitAnswer's doc comment).
# Set `connection_limit` explicitly in production, sized to Postgres's
# own max_connections and expected concurrency — 10-20 is a reasonable
# starting point for a beta-scale deployment; raise `pool_timeout` (in
# seconds) alongside it if you also raise `connection_limit` well above
# what's typically free.
DATABASE_URL="postgresql://wordquest:wordquest@localhost:5432/wordquest?schema=public&connection_limit=10&pool_timeout=20"

# ── Redis ────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth ─────────────────────────────
JWT_ACCESS_SECRET=replace-me-in-local-env
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-me-in-local-env
JWT_REFRESH_EXPIRES_IN=30d

# ── Object storage (S3-compatible) ──
# Word in the Wild photo evidence. Cloudflare R2 today (an S3-compatible
# API, no code differences from AWS S3). R2 dashboard -> Manage API Tokens
# -> Create API Token -> "Object Read & Write" -> scoped to one bucket.
# S3_ENDPOINT looks like https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── AI orchestration ─────────────────
# Word in the Wild evidence assessment (text + photo). An Anthropic API
# key from https://console.anthropic.com — Claude reads and judges
# submitted evidence in one call. AI_PROVIDER_MODEL defaults to
# claude-sonnet-5 if left blank.
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=

# ── Transactional email (verification, password reset) ──
# EmailService's default implementation talks to Resend's HTTP API —
# swap EmailService's own send() method if a different provider is
# preferred; nothing else in the auth flow depends on which one.
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

# Base URL the verification/reset links in emails point at — the
# mobile app's deep link or web fallback, not this API server.
APP_BASE_URL=https://app.wordquest.example

# ── Error tracking ───────────────────
# MonitoringService (src/common/monitoring.service.ts) — every unhandled
# exception across every route is reported here via AllExceptionsFilter.
# Left blank locally/in CI: errors still log locally (structured, via
# Nest's Logger), they just aren't forwarded to Sentry.
SENTRY_DSN=

